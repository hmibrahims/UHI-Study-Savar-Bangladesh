library(dplyr)
library(readr)
# 1) Read ERA5 scene-level CSV
era5_scene <- read_csv("ERA5Land_t2m_scene_matched_ALLBLOCKS.csv")
# 2) Summarise by year block
era5_block <- era5_scene %>%
group_by(year_group) %>%
summarise(
n_scenes  = n(),
ERA5_mean = mean(era5_t2m_c, na.rm = TRUE),
ERA5_sd   = sd(era5_t2m_c, na.rm = TRUE),
ERA5_p25  = quantile(era5_t2m_c, 0.25, na.rm = TRUE),
ERA5_p50  = quantile(era5_t2m_c, 0.50, na.rm = TRUE),
ERA5_p75  = quantile(era5_t2m_c, 0.75, na.rm = TRUE)
) %>%
arrange(year_group)
# 3) Inspect
print(era5_block)
# 4) Save (important)
write_csv(era5_block, "ERA5_block_summary.csv")
