df <- read_csv(
"SUHI_ERA5_block_analysis.csv",
locale = locale(encoding = "Latin1"),
show_col_types = FALSE
)
# Check columns (optional)
print(names(df))
print(df)
# =========================================================
# STEP 4B — Clean/rename columns (fix the ¡C issue)
# =========================================================
df2 <- df %>%
rename(
rural_mean_c = `Rural_Mean ¡C`,
urban_mean_c = `Urban_Mean ¡C`,
suhi_mean_c  = `SUHI_Mean ¡C`,
suhi_sd      = SUHI_SD,
urban_km2    = Urban_Area_km_,
veg_km2      = Vagetated_Area_km_,
water_km2    = Waterbody_km_,
other_km2    = Others_km_,
total_km2    = Total_Area_km_
) %>%
mutate(
year_group = as.character(year_group)
)
# Confirm cleaned structure
print(df2 %>% select(year_group, suhi_mean_c, ERA5_mean, urban_km2, n_scenes))
# Save cleaned version (optional but recommended)
write_csv(df2, "STEP4_clean_block_table.csv")
# Check columns (optional)
print(names(df))
print(df)
